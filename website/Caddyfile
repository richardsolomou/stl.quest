{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	header X-Content-Type-Options nosniff
	# Vite fingerprints every file under /assets, so a changed file always has a new name.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html
	file_server
}
