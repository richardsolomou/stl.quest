{
  "name": "stl.quest",
  "version": "1.26.3",
  "private": true,
  "description": "A private 3D-print request and production queue for resin and filament printers.",
  "homepage": "https://stl.quest",
  "bugs": "https://github.com/richardsolomou/stl.quest/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/stl.quest.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx scripts/checkBuiltAssets.ts && esbuild src/server/assets/worker.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/server/assets-worker.mjs --log-level=warning && esbuild scripts/seedPreview.ts --bundle --external:better-sqlite3 --external:argon2 --platform=node --format=esm --target=node24 --define:import.meta.env.PROD=true --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=.output/server/seed-preview.mjs --log-level=warning && esbuild scripts/containerRuntime.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/server/container-runtime.mjs --log-level=warning && ras assets sync",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "policy:sync": "ras policy sync",
    "policy:check": "ras policy check",
    "realtime": "ras realtime --config realtime.json --name stlquest-realtime-dev --port 8000 --origin http://localhost:3000 --secret stlquest-development-realtime-secret",
    "check": "pnpm check:ci && pnpm test",
    "check:ci": "pnpm format:check && pnpm lint && pnpm policy:check && pnpm check:docs && pnpm db:check && pnpm catalog:check && pnpm check:unraid && pnpm check:changesets && pnpm build && pnpm typecheck && pnpm check:cli",
    "test": "vitest run",
    "check:cli": "node --import tsx scripts/backup.ts --help",
    "check:docs": "tsx scripts/checkMarkdownLinks.ts",
    "check:unraid": "tsx scripts/checkUnraidMetadata.ts",
    "check:changesets": "tsx scripts/checkChangesets.ts",
    "catalog:check": "tsx scripts/syncPrinterCatalog.ts --check",
    "catalog:sync": "tsx scripts/syncPrinterCatalog.ts",
    "catalog:update": "tsx scripts/syncPrinterCatalog.ts --update && tsx scripts/updatePrinterImages.ts --update && tsx scripts/syncPrinterCatalog.ts",
    "catalog:update-images": "tsx scripts/updatePrinterImages.ts && tsx scripts/syncPrinterCatalog.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx scripts/syncReleaseVersion.ts",
    "release": "changeset git-tag",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:check": "drizzle-kit check && drizzle-kit check --config drizzle.postgres.config.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/stripe": "1.6.30",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@posthog/react": "^1.10.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.46",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@tus/file-store": "^2.1.1",
    "@tus/s3-store": "2.0.6",
    "@tus/server": "^2.4.4",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "better-auth": "^1.6.30",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "1.9.4",
    "centrifuge": "5.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fast-png": "^8.0.0",
    "fast-xml-parser": "5.11.0",
    "fflate": "^0.8.3",
    "ioredis": "6.0.0",
    "lucide-react": "^1.31.0",
    "meshoptimizer": "^1.2.0",
    "nodemailer": "^9.0.5",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.0",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "posthog-js": "^1.417.3",
    "posthog-node": "^5.49.1",
    "qrcode": "^1.5.4",
    "ras-stack": "^0.46.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-icons": "5.7.0",
    "react-joyride": "3.2.0",
    "redis-semaphore": "5.7.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "webdav": "5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
