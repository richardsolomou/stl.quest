# Host paths for the two container mounts. Everything else — storage,
# board visibility, telemetry — is configured in the app under Settings.
DATA_HOST_DIR=./stlquest-data
PRINTS_HOST_DIR=./prints
# Published web interface port. The container continues to listen on 3000.
WEB_PORT=30455
# Use PostgreSQL instead of local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/stlquest
# Distributed mode requires PostgreSQL, Redis or Valkey, shared S3-compatible upload
# staging, and an environment-managed integration encryption key.
# STLQUEST_DISTRIBUTED=true
# REDIS_URL=redis://host:6379
# S3_BUCKET=stlquest-staging
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Per-replica visual asset processing limits.
# ASSET_WORKER_CONCURRENCY=8
# ASSET_WORKER_MEMORY_MB=4096
# Override a saved local storage path during recovery or restore testing.
# PRINTS_DIR_OVERRIDE=/prints
PUID=1000
PGID=1000
# Set to true when one deployment serves independent customer workspaces.
# STLQUEST_HOSTED=true
# Deployment-managed S3-compatible storage for hosted workspaces. The app keeps
# credentials server-side, namespaces objects by workspace, and enforces 1 GB.
# STLQUEST_HOSTED_STORAGE_BUCKET=stlquest-hosted
# STLQUEST_HOSTED_STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# STLQUEST_HOSTED_STORAGE_REGION=auto
# STLQUEST_HOSTED_STORAGE_ACCESS_KEY_ID=
# STLQUEST_HOSTED_STORAGE_SECRET_ACCESS_KEY=
# STLQUEST_HOSTED_STORAGE_PREFIX=
# STLQUEST_HOSTED_STORAGE_FORCE_PATH_STYLE=false
# Optional overrides when proxy headers cannot represent the public origin.
# BETTER_AUTH_URL=https://stlquest.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://alternate.stlquest.example.com
# Setting SMTP_HOST switches email delivery from Admin settings to the
# environment; EMAIL_FROM is then required and SMTP_PORT defaults to 587.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=stlquest@example.com
# Override password sign-in; AUTH_PASSWORD_RECOVERY=true forces it on to
# recover a deployment locked out of its social login.
# AUTH_PASSWORD_ENABLED=true
# AUTH_PASSWORD_RECOVERY=false
# Social provider credentials must be configured in pairs. The optional
# enabled flags default to true and can disable a configured provider.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_ENABLED=true
# AUTH_DISCORD_CLIENT_ID=
# AUTH_DISCORD_CLIENT_SECRET=
# AUTH_DISCORD_ENABLED=true
# Base64url-encoded 32-byte key used instead of /data/integration-secrets.key.
# INTEGRATIONS_ENCRYPTION_KEY=
# Pino log level (default info).
# LOG_LEVEL=info
# PostHog analytics — both vars are required together to enable telemetry.
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
